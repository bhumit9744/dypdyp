# Database Configuration (PostgreSQL with fallback to SQLite for local development)
DATABASE_URL=sqlite:///./placement_hub.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_hub

# =============================================================================
# Google Gemini AI Provider Configuration (Official google-genai SDK)
# Multi-project failover: Configure multiple credentials belonging to distinct
# Google Cloud projects for high-availability. Never share keys with frontend.
# =============================================================================

# Primary Gemini Credential
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_PROJECT_ID=placement-hub-primary
GEMINI_MODEL=gemini-3.5-flash-lite

# Secondary Backup Gemini Credential (Optional - Must belong to a DISTINCT GCP project)
# GEMINI_API_KEY_2=your_secondary_gemini_api_key_here
# GEMINI_PROJECT_ID_2=placement-hub-backup

# Tertiary Backup Gemini Credential (Optional)
# GEMINI_API_KEY_3=your_tertiary_gemini_api_key_here
# GEMINI_PROJECT_ID_3=placement-hub-tertiary

# Structured Multi-Project JSON Configuration (Optional alternative):
# GEMINI_CREDENTIALS=[{"api_key": "...", "project_id": "proj-1", "alias": "primary"}, {"api_key": "...", "project_id": "proj-2", "alias": "backup"}]

# App Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
